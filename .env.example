# --- Supabase (Project settings > API) ---------------------------------------
# Public: safe in the browser. RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://qtjvgbllqzhqlwgvguyf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_O4DUcDCglNNOnB8EdfDleg_-JvmtHYK

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for member links and rate limits.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------------
# Used to build member links and wa.me reminder links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp Cloud API (Phase 2 reminders; off by default) --------------------
FEATURE_WA_CLOUD=false
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_ACCESS_TOKEN=
WA_CLOUD_TEMPLATE=nkapbook_contribution_due
# Shared secret the cron job sends to /api/cron/reminders
CRON_SECRET=

# --- Tests ----------------------------------------------------------------------
# Superuser URL of a local Postgres for the security tests (npm run test:db).
TEST_PG_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

# --- NkapBook subscription (groups pay you; shown to officials in Settings) ----
SUBSCRIPTION_PRICE_XAF=2000
# Longer periods (defaults: 6 months = 5 x monthly, 12 months = 10 x monthly)
SUBSCRIPTION_PRICE_6M=10000
SUBSCRIPTION_PRICE_12M=20000
SUBSCRIPTION_MTN_NUMBER=
SUBSCRIPTION_ORANGE_NUMBER=
SUBSCRIPTION_PAYEE_NAME=
# WhatsApp number treasurers message after paying (defaults to the MTN number)
SUBSCRIPTION_WHATSAPP_NUMBER=
# Optional Stripe Payment Link for card payments (https://buy.stripe.com/...). The group reference is added
# as client_reference_id. Record the payment in /admin when Stripe tells you it arrived.
SUBSCRIPTION_STRIPE_LINK=
