# --- Supabase (Project settings > API) ---------------------------------------
# Public: safe in the browser. RLS protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://qtjvgbllqzhqlwgvguyf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_O4DUcDCglNNOnB8EdfDleg_-JvmtHYK

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used for member links and rate limits.
SUPABASE_SERVICE_ROLE_KEY=

# --- App ----------------------------------------------------------------------
# Used to build member links and wa.me reminder links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- WhatsApp Cloud API (Phase 2 reminders; off by default) --------------------
FEATURE_WA_CLOUD=false
WA_CLOUD_PHONE_NUMBER_ID=
WA_CLOUD_ACCESS_TOKEN=
# Shared secret the cron job sends to /api/cron/reminders
CRON_SECRET=

# --- Tests ----------------------------------------------------------------------
# Superuser URL of a local Postgres for the security tests (npm run test:db).
TEST_PG_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres
