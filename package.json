{
  "name": "nkapbook",
  "version": "0.1.0",
  "private": true,
  "description": "NkapBook: clear njangi records. No palaver.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test --trace off",
    "check": "npm run typecheck && npm test && npm run test:db && npm run build",
    "pidgin:review": "node --experimental-strip-types scripts/pidgin-review.mts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.2",
    "idb": "8.0.4",
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.20.7",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "pg": "8.23.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  }
}
