// Writes docs/pidgin-review.md: every English string next to its Pidgin, flagged until reviewed.
import { writeFileSync } from "node:fs";
import en from "../src/i18n/en.ts";
import pcm, { reviewed } from "../src/i18n/pcm.ts";

function flat(o: object, prefix = ""): [string, string][] {
  return Object.entries(o).flatMap(([k, v]) =>
    typeof v === "string" ? [[prefix + k, v] as [string, string]] : flat(v as object, `${prefix}${k}.`),
  );
}
const p = new Map(flat(pcm));
const rows = flat(en).map(([k, e]) => {
  const status = reviewed.includes(k) ? "✅" : "⚠️ review";
  const esc = (s: string) => s.replace(/\|/g, "\\|");
  return `| \`${k}\` | ${esc(e)} | ${esc(p.get(k) ?? "")} | ${status} |`;
});
const todo = rows.filter((r) => r.includes("⚠️")).length;
writeFileSync(
  "docs/pidgin-review.md",
  `# Pidgin strings for review\n\nGenerated by \`npm run pidgin:review\`. ${todo} of ${rows.length} strings still need review.\n` +
    `To approve a string, add its key to \`reviewed\` in \`src/i18n/pcm.ts\`. To change one, edit it there.\n\n` +
    `| Key | English | Pidgin | Status |\n|---|---|---|---|\n${rows.join("\n")}\n`,
);
console.log(`docs/pidgin-review.md: ${todo}/${rows.length} to review`);
